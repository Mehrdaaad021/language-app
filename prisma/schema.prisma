generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/* ═══════════════════ ENUMS ═══════════════════ */

enum Role {
  TEACHER
  STUDENT
}

enum PlatformAccess {
  USER
  ADMIN
}

/* ═══════════════════ USER (حساب کاربری) ═══════════════════ */

model User {
  id                  String           @id @default(cuid())
  name                String?
  email               String           @unique
  password            String
  mustChangePassword  Boolean          @default(false)
  role                Role             @default(TEACHER)
  platformRole        PlatformAccess   @default(USER)
  suspended           Boolean          @default(false)
  suspendedAt         DateTime?
  twoFactorEnabled    Boolean          @default(false)
  twoFactorSecret     String?
  backupCodes         String?
  inviteExpiresAt     DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  workspaces      Workspace[]
  student         Student?
  notifications   Notification[]
  supportTickets  SupportTicket[]
}

/* ═══════════════════ WORKSPACE (کلاس معلم) ═══════════════════ */

model Workspace {
  id         String    @id @default(cuid())
  name       String
  ownerId    String    @unique
  verified   Boolean   @default(false)
  verifiedAt DateTime?
  suspended  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  slug    String?         @unique
  landing LandingContent?
  owner     User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  students  Student[]
  sessions  Session[]
  payments  Payment[]
  notes     Note[]
  homeworks Homework[]
  messages  Message[]
    bookings BookingRequest[]
}

/* ═══════════════════ STUDENT (شاگرد) ═══════════════════ */

model Student {
  id                String    @id @default(cuid())
  workspaceId       String
  userId            String?   @unique
  name              String
  email             String?
  phone             String?
  level             String?
  term              String?
  active            Boolean   @default(true)
  verified          Boolean   @default(false)
  inviteToken       String?   @unique
  invitedAt         DateTime?
  inviteExpiresAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessions   Session[]
  payments   Payment[]
  notes      Note[]
  homeworks  Homework[]
  messages   Message[]

  @@index([workspaceId])
}

/* ═══════════════════ SESSION (جلسه) ═══════════════════ */

model Session {
  id               String    @id @default(cuid())
  workspaceId      String
  studentId        String
  date             DateTime
  topic            String?
  status           String    @default("SCHEDULED") // SCHEDULED | COMPLETED | CANCELLED
  score            Int?
  studentConfirmed Boolean   @default(false)
  confirmedAt      DateTime?
  createdAt        DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([studentId])
}

/* ═══════════════════ PAYMENT (پرداخت) ═══════════════════ */

model Payment {
  id          String   @id @default(cuid())
  workspaceId String
  studentId   String
  amount      Int
  date        DateTime
  status      String   @default("PENDING") // PENDING | PAID | OVERDUE
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([studentId])
}

/* ═══════════════════ NOTE (دفترچه مشق) ═══════════════════ */

model Note {
  id          String   @id @default(cuid())
  workspaceId String
  studentId   String
  title       String
  content     String
  date        DateTime
  attachments Json     @default("[]")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([studentId])
}

/* ═══════════════════ HOMEWORK (تکلیف) ═══════════════════ */

model Homework {
  id             String    @id @default(cuid())
  workspaceId    String
  studentId      String
  title          String
  description    String    @default("")
  dueDate        DateTime?
  status         String    @default("OPEN") // OPEN | SUBMITTED | GRADED
  submissionText String    @default("")
  submittedAt    DateTime?
  feedback       String    @default("")
  score          Int?
  createdAt      DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([studentId])
}

/* ═══════════════════ MESSAGE (چت) ═══════════════════ */

model Message {
  id          String    @id @default(cuid())
  workspaceId String
  studentId   String
  sender      String    // TEACHER | STUDENT
  text        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([studentId])
}

/* ═══════════════════ NOTIFICATION (اعلان) ═══════════════════ */

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
/* ═══════════════════ LOGIN ATTEMPT (ضد brute-force) ═══════════════════ */

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  success   Boolean
  ip        String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}
/* ═══════════════════ SUPPORT TICKET (تیکت پشتیبانی) ═══════════════════ */

model SupportTicket {
  id        String    @id @default(cuid())
  userId    String
  subject   String
  message   String
  status    String    @default("OPEN") // OPEN | REPLIED | CLOSED
  reply     String    @default("")
  createdAt DateTime  @default(now())
  repliedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}
/* ═══════════════════ LANDING CONTENT (لندینگ شخصی هر معلم) ═══════════════════ */

model LandingContent {
  id           String   @id @default(cuid())
  workspaceId  String?  @unique
  heroBadge    String   @default("")
  heroTitle1   String   @default("")
  heroTitle2   String   @default("")
  heroSub      String   @default("")
  ctaPrimary   String   @default("")
  ctaSecondary String   @default("")
  accentColor  String   @default("#D94F63")
  aboutText    String   @default("")
  contactInfo  String   @default("")
  features     Json     @default("[]")
  testimonials Json     @default("[]")
  pricing      Json     @default("[]")
  updatedAt    DateTime @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}
model BookingRequest {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  phone       String
  note        String   @default("")
  status      String   @default("NEW")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}
/* ═══════════════════ SITE CONFIG (محتوای لندینگ اصلی) ═══════════════════ */

model SiteConfig {
  id        Int      @id @default(1)
  config    Json
  updatedAt DateTime @updatedAt
}
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt
}